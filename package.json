{
	"name": "para-kanban",
	"version": "0.1.3",
	"description": "A customizable kanban view for Obsidian Bases: create cards from templates, delete from the card, cap the board height, and hide columns.",
	"main": "main.js",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tyrandel-0/obsidian-para-kanban.git"
	},
	"homepage": "https://github.com/tyrandel-0/obsidian-para-kanban",
	"bugs": {
		"url": "https://github.com/tyrandel-0/obsidian-para-kanban/issues"
	},
	"imports": {
		"obsidian": "./tests/mocks/obsidian.ts",
		"sortablejs": "./tests/mocks/sortablejs.js"
	},
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"test": "NODE_NO_WARNINGS=1 tsx --tsconfig tsconfig.test.json --test tests/*.test.ts",
		"prepare": "git config core.hooksPath .githooks",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "biome format --write .",
		"format:check": "biome format --diagnostic-level=error ."
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"kanban",
		"bases",
		"task-management"
	],
	"author": "tyrandel",
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "^2.4.8",
		"@types/jsdom": "^21.1.6",
		"@types/node": "^24.0.0",
		"@types/sortablejs": "^1.15.9",
		"@typescript-eslint/eslint-plugin": "^8.0.0",
		"@typescript-eslint/parser": "^8.0.0",
		"esbuild": "^0.28.0",
		"eslint": "^9.0.0",
		"eslint-plugin-obsidianmd": "^0.3.0",
		"jsdom": "^24.0.0",
		"obsidian": "^1.5.8",
		"tslib": "2.6.2",
		"tsx": "^4.20.6",
		"typescript": "5.3.3"
	},
	"dependencies": {
		"sortablejs": "^1.15.0"
	}
}
